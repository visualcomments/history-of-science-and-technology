{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaotic-good-project/physics-dataset-competition/harness/schema/calibration_case.schema.json",
  "title": "AgentCalibrationCase",
  "description": "Кейс разработческой калибровки агента (harness): промпт + ожидания + контекст источника. Сырые бинарники и секреты запрещены; каждое ожидаемое значение обязано иметь координаты источника ('путь#координата'). Машинная проверка — stdlib-валидатор в harness/core.py, эквивалентный этой схеме.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "schema_version",
    "domain",
    "source",
    "prompt",
    "expected",
    "expert_notes",
    "provenance",
    "split",
    "license"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{4,64}$",
      "description": "Идентификатор кейса; стабилен между прогонами и реплеями."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Версия формата кейса (SemVer)."
    },
    "domain": {
      "enum": ["AERO", "STR", "RADAR", "CTRL"],
      "description": "Домен физического модуля."
    },
    "subdomain": {"type": "string"},
    "source": {
      "type": "object",
      "description": "Метаданные первоисточника. Сырые бинарники (pdf/скан/zip) запрещены — только метаданные и короткая выдержка.",
      "additionalProperties": false,
      "required": ["source_type", "title", "rights"],
      "properties": {
        "source_type": {
          "enum": ["book", "article", "report", "dataset", "standard", "patent", "thesis", "other"]
        },
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "items": {"type": "string"}},
        "year": {"type": "integer"},
        "language": {"type": "string"},
        "doi": {"type": "string"},
        "url": {
          "type": "string",
          "description": "Ссылка на метаданные источника; не должна указывать на сырой бинарник (.pdf/.zip/.png/...)."
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2000,
          "description": "Короткая текстовая выдержка. Полный текст/скан не хранится."
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reusable", "redistributable", "basis"],
          "properties": {
            "reusable": {"type": "boolean"},
            "redistributable": {"type": "boolean"},
            "basis": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Задача агенту. Секреты (токены/ключи) запрещены и отклоняются валидатором."
    },
    "expected": {
      "type": "object",
      "description": "Ожидаемый результат: либо полный набор записей по record.schema.json, либо явные покомпонентные ограничения (constraints). Ровно один вариант.",
      "oneOf": [
        {"required": ["records"], "not": {"required": ["constraints"]}},
        {"required": ["constraints"], "not": {"required": ["records"]}}
      ],
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "description": "Ожидаемые записи; структура каждой — configs/schema/record.schema.json. Каждое value дополнительно обязано нести source_ref.location с координатами '#'.",
          "items": {"type": "object"}
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "description": "Явные ожидания по значениям (без полной записи).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit", "source_ref"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "string", "array"]},
              "unit": {"type": "string", "minLength": 1},
              "tolerance": {
                "type": "number",
                "minimum": 0,
                "description": "Допуск абсолютной погрешности; 0 = точное совпадение (с эпсилон 1e-12)."
              },
              "source_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": ["location"],
                "properties": {
                  "location": {
                    "type": "string",
                    "minLength": 3,
                    "pattern": "#",
                    "description": "Координаты значения в источнике: 'путь#фрагмент/строка/страница'. Обязательно."
                  },
                  "note": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "expert_notes": {
      "type": "string",
      "description": "Замечания эксперта, зафиксированные при подготовке кейса (не заменяют финальное одобрение)."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method", "sha256"],
      "properties": {
        "activity": {"type": "string"},
        "agent_role_id": {"type": "string"},
        "retrieved_at": {"type": "string"},
        "method": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 источника/выдержки, из которой взяты ожидания."
        }
      }
    },
    "split": {
      "enum": ["train", "validation", "test"],
      "description": "Разбиение набора кейсов."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX-идентификатор лицензии кейса или 'metadata-only'."
    }
  }
}
